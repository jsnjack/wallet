<?xml version="1.0" encoding="utf-8"?>
<!-- Cards and settings go with Android backup and Smart Switch transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="wallet.db" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="wallet.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
