<?xml version="1.0" encoding="utf-8"?>
<!-- Cards and settings go with Android backup and Smart Switch transfers; flight lookups are short-lived and stay. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="wallet.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="flights.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="wallet.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="flights.xml" />
    </device-transfer>
</data-extraction-rules>
